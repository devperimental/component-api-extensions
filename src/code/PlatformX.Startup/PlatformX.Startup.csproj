    <PackageReference Include="AWSSDK.StepFunctions" Version="4.0.2.22" />
    <PackageReference Include="Destructurama.Attributed" Version="4.1.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
